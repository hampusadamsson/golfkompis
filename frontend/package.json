		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.6.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
